# Database
DATABASE_URL=sqlite:///./test.db

# Active LLM Provider: 'gemini', 'groq' (or 'grok'), 'qwen' (or 'ollama'), or 'mock'
LLM_PROVIDER=gemini

# 1. Google Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.1-flash-lite

# 2. Groq / Grok Cloud Settings (Fast inference)
# Free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Local Qwen Settings (100% Offline via Ollama)
# Run 'ollama pull qwen2.5:3b' and 'ollama serve'
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db

# Mock mode (set to true to use offline deterministic rules without any LLM)
MOCK_MODE=false
